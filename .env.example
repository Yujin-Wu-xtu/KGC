KGC_DB_URL=jdbc:mysql://127.0.0.1:3306/kgc_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
KGC_DB_USERNAME=root
KGC_DB_PASSWORD=

JWT_SECRET_KEY=replace-with-a-long-base64-encoded-secret

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_DAILY_LIMIT=10

KGC_MAIL_HOST=smtp.example.com
KGC_MAIL_PORT=587
KGC_MAIL_USERNAME=replace-with-mailbox@example.com
KGC_MAIL_PASSWORD=replace-with-smtp-authorization-code
KGC_MAIL_FROM=replace-with-mailbox@example.com
KGC_MAIL_SMTP_AUTH=true
KGC_MAIL_SMTP_STARTTLS=true
KGC_MAIL_SMTP_SSL=false

TENCENT_SMS_ENABLED=false
TENCENTCLOUD_SECRET_ID=replace-with-tencent-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=replace-with-sms-sdk-app-id
TENCENT_SMS_SIGN_NAME=replace-with-approved-sms-sign
TENCENT_SMS_TEMPLATE_ID=replace-with-approved-template-id
